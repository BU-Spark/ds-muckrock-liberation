# Copy to .env.local for local dev. On Vercel, add the same two variables in Project Settings > Environment Variables.
# Supabase > Project Settings > API: Project URL and the "anon public" key (safe to expose: tables are read-only).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
